#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "==> verify: start"

has_python=0
has_swift=0
has_rust=0
has_macos_auth_helper=0
sh_files=()
bicep_files=()

changed=0
while IFS= read -r -d '' entry; do
  changed=1
  path="${entry#?? }"
  # Porcelain -z emits the old name as a second record for renames/copies.
  case "${entry:0:2}" in
    *R*|*C*) IFS= read -r -d '' old_path || exit 1 ;;
  esac
  case "$path" in
    scripts/macos/envrcctl-macos-auth.swift|scripts/build_macos_auth_helper.sh)
      has_macos_auth_helper=1
      has_swift=1
      ;;
    *.py|pyproject.toml|uv.lock|requirements.txt) has_python=1 ;;
    *.swift|Package.swift) has_swift=1 ;;
    *.rs|Cargo.toml) has_rust=1 ;;
    *.sh) sh_files+=("$path") ;;
    *.bicep) bicep_files+=("$path") ;;
  esac
done < <(git status --porcelain -z --untracked-files=all)

if (( changed == 0 )); then
  echo "==> verify: no changes; skipping"
  exit 0
fi

ran=0

have_cmd() { command -v "$1" >/dev/null 2>&1; }
skip_cmd() { echo "==> $1: $2 not installed; skipping"; }

if (( has_python == 1 )); then
  if [[ -x .venv/bin/python ]]; then
    python_cmd=(.venv/bin/python)
  elif have_cmd uv; then
    python_cmd=(uv run --no-sync python)
  else
    echo "ERROR: Project Python unavailable. Install uv and run: uv sync --locked --extra test --group dev" >&2
    exit 1
  fi
  for module in pytest bandit; do
    if ! "${python_cmd[@]}" -m "$module" --version >/dev/null 2>&1; then
      echo "ERROR: Project $module unavailable. Run: uv sync --locked --extra test --group dev" >&2
      exit 1
    fi
  done
  echo "==> python: pytest"
  "${python_cmd[@]}" -m pytest -q
  ran=1
  echo "==> python: bandit"
  "${python_cmd[@]}" -m bandit -r src -x tests -s B404,B603,B607
fi

if (( has_macos_auth_helper == 1 )); then
  if have_cmd sh && have_cmd swiftc; then
    echo "==> macOS auth helper: build"
    python3 scripts/release_artifacts.py --helper-only && ran=1 || exit 1
  else
    skip_cmd "macOS auth helper" "sh/swiftc"
  fi
fi

if (( has_swift == 1 )); then
  if have_cmd swift; then
    if [[ -f Package.swift ]]; then
      echo "==> swift: swift test"
      swift test && ran=1 || exit 1
    else
      echo "==> swift: no Package.swift; skipping swift test"
    fi
  else
    skip_cmd "swift" "swift"
  fi
fi

if (( has_rust == 1 )); then
  if have_cmd cargo; then
    echo "==> rust: cargo test"
    cargo test && ran=1 || exit 1
  else
    skip_cmd "rust" "cargo"
  fi
fi

if (( ${#sh_files[@]} > 0 )); then
  if have_cmd shellcheck; then
    echo "==> bash: shellcheck"
    shellcheck "${sh_files[@]}" && ran=1 || exit 1
  else
    skip_cmd "bash" "shellcheck"
  fi
fi

if (( ${#bicep_files[@]} > 0 )); then
  if have_cmd az; then
    echo "==> bicep: az bicep lint"
    for bicep_file in "${bicep_files[@]}"; do
      az bicep lint -f "$bicep_file" && ran=1 || exit 1
    done
  elif have_cmd bicep; then
    echo "==> bicep: bicep lint"
    for bicep_file in "${bicep_files[@]}"; do
      bicep lint "$bicep_file" && ran=1 || exit 1
    done
  else
    skip_cmd "az/bicep" "az/bicep"
  fi
fi

if [[ "$ran" -eq 0 ]]; then
  echo "WARN: No known test/build targets detected. Add checks to .zed/scripts/verify."
fi

echo "==> verify: OK"
